<div class="itemBoxStyle">

		<div class="ContentHeaderBright" style="padding:2px;border:1px solid #FF8001; background-color:#4E070D; color:#FF8001>
		<a href="<%permalinkUrl%>"><%ItemTitle%></a>
			</div>
			
			
	<div class="ContentSmallBright" style="color:#cc9901">
	
                posted: <%formattedWhenBare("h:mm tt, MMM dd, yyyy")%>  
                <span class="ContentSmallBright" style="font-size:11px;color:#cc9901">by: <%itemAuthor%></span>
         </div>  

	<div class="ContentMain">
		<%ItemBody%>
	</div>

	<div class="ContentSmall" align="right">
		<%editButton%>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
	
		<a href="<%permalinkUrl%>">permalink</a>&nbsp;|&nbsp;
		<%commentLink%>&nbsp;|&nbsp;	
		<%trackbackList%>&nbsp;|&nbsp;
		categories: [<%categoryLinks%>]
	</div>
	<hr />
</div>